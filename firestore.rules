rules_version = '2';

// 캠프베이스 Firestore 보안 규칙
// 이 파일은 GitHub에 올려도 자동으로 적용되지 않아요.
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 전부 붙여넣고 "게시"를 눌러야 적용돼요.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 1. 개인 공간 ───────────────────────────────────────────
    // 구글로 로그인한 본인만 자기 공간(users/{내 uid}/...)을 읽고 쓸 수 있어요.
    //   users/{uid}                          : 계정 정보 { name, email, photoURL, updatedAt }
    //   users/{uid}/campingLogs|gear|checklists|cookingChecks/{id}
    //   users/{uid}/settings/app             : { gearCategories, weatherLocation, homeWidgets }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── 2. 전환 기간: 예전 공유 저장소(최상위 경로) ─────────────────
    // 아직 업데이트하지 않은 예전 APK(로그인 없음)가 계속 쓸 수 있도록 지금은 예전처럼 열어둬요.
    // 새 앱은 Settings → "기존 공유 데이터 가져오기"에서 읽기만 해요.
    //
    // 모두 새 앱으로 옮기고 나면 아래 순서로 닫아요.
    //   (1단계) 로그인한 사람만 읽기 전용 — 아래 다섯 줄의 "if true"를
    //           read:  "if request.auth != null"  으로,  write: "if false" 로 바꾸기
    //           예) match /gear/{id} { allow read: if request.auth != null; allow write: if false; }
    //   (2단계) 삭제 — 가져오기가 더 필요 없으면 "전환 기간" 블록(아래 다섯 줄)을 통째로 지우기
    //           → 그 경로는 3번 규칙에 따라 전부 거부돼요.
    // ── 전환 기간 시작 ──
    match /campingLogs/{id}   { allow read, write: if true; }
    match /gear/{id}          { allow read, write: if true; }
    match /checklists/{id}    { allow read, write: if true; }
    match /cookingChecks/{id} { allow read, write: if true; }
    match /app/{id}           { allow read, write: if id == 'settings'; }
    // ── 전환 기간 끝 ──

    // ── 3. 그 밖의 경로 ───────────────────────────────────────
    // 위에서 허용하지 않은 곳은 규칙이 하나도 맞지 않으므로 전부 거부돼요.
  }
}
